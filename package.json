{
  "name": "desktop-teklif",
  "version": "1.0.0",
  "description": "MRP teklif klasoru olusturma uygulamasi",
  "main": "main.js",
  "author": "Epron",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "dist:win": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tr.epron.desktop-teklif",
    "productName": "Desktop Teklif",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "preload-webview.js",
      "preload-fab.js",
      "preload-teklif-modal.js",
      "fab.html",
      "fab.js",
      "teklif-modal.html",
      "teklif-modal.js",
      "index.html",
      "renderer.js",
      "operasyon.js",
      "styles.css",
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "örnek klasör",
        "to": "örnek klasör"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Desktop-Teklif--portable.exe"
    },
    "portable": {
      "artifactName": "Desktop-Teklif--portable.exe"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["AppImage"],
      "category": "Office",
      "artifactName": "Desktop-Teklif--${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": ["dmg", "zip"],
      "category": "public.app-category.business",
      "artifactName": "Desktop-Teklif--${version}.${ext}"
    }
  }
}
