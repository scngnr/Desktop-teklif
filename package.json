{
  "name": "desktop-teklif",
  "version": "1.0.0",
  "description": "MRP teklif klasoru olusturma uygulamasi",
  "main": "main.js",
  "author": "Epron",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tr.epron.desktop-teklif",
    "productName": "Desktop Teklif",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "preload-fab.js",
      "preload-teklif-modal.js",
      "fab.html",
      "fab.js",
      "teklif-modal.html",
      "teklif-modal.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "örnek klasör",
        "to": "örnek klasör"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Desktop-Teklif--portable.exe"
    },
    "portable": {
      "artifactName": "Desktop-Teklif--portable.exe"
    }
  }
}
